                }
              }
            }
          },
          "404": {
            "description": "Solar installation not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Solar Installations"
        ]
      }
    },
