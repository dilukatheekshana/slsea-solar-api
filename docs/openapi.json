{
  "openapi": "3.0.3",
  "info": {
    "title": "SLSEA Solar Generation API",
    "version": "1.0.0",
    "description": "RESTful API for Sri Lanka Sustainable Energy Authority solar generation telemetry, geographic hierarchy, and operational analytics."
  },
  "servers": [
    {
      "url": "https://slsea-solar-api-git-dev-diluka-theekshana-s-projects.vercel.app",
      "description": "Production Vercel Serverless"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "security": [
    {
      "UserAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "UserAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-Id",
        "description": "User ID or Username for RBAC: 1 / national_admin, 2 / provincial_officer, 3 / district_operator"
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API Key for meter telemetry device ingestion (e.g. key_inst_1)"
      }
    },
    "schemas": {
      "Province": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Western Province"
          },
          "code": {
            "type": "string",
            "example": "WP"
          }
        }
      },
      "District": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Colombo"
          },
          "code": {
            "type": "string",
            "example": "CM"
          },
          "province_id": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "GridSubstation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Colombo Central Grid Substation"
          },
          "capacity_mva": {
            "type": "number",
            "example": 100
          },
          "district_id": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "SolarInstallation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Solar Installation 001"
          },
          "meter_id": {
            "type": "string",
            "example": "SLMTR-00001"
          },
          "inverter_id": {
            "type": "string",
            "example": "INV-00001"
          },
          "substation_id": {
            "type": "integer",
            "example": 1
          },
          "latitude": {
            "type": "number",
            "example": 6.939648
          },
          "longitude": {
            "type": "number",
            "example": 79.818451
          },
          "capacity_kw": {
            "type": "number",
            "example": 8
          }
        }
      },
      "GenerationReading": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 672
          },
          "installation_id": {
            "type": "integer",
            "example": 1
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-26T23:45:00.000Z"
          },
          "power_kw": {
            "type": "number",
            "example": 4.5
          },
          "cumulative_energy_kwh": {
            "type": "number",
            "example": 388.601
          },
          "voltage": {
            "type": "number",
            "example": 226
          }
        }
      },
      "CompositeInstallation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Solar Installation 001"
          },
          "meter_id": {
            "type": "string",
            "example": "SLMTR-00001"
          },
          "inverter_id": {
            "type": "string",
            "example": "INV-00001"
          },
          "substation_id": {
            "type": "integer",
            "example": 1
          },
          "latitude": {
            "type": "number",
            "example": 6.939648
          },
          "longitude": {
            "type": "number",
            "example": 79.818451
          },
          "capacity_kw": {
            "type": "number",
            "example": 8
          },
          "last_reading": {
            "$ref": "#/components/schemas/GenerationReading",
            "nullable": true
          }
        }
      },
      "DistrictSummary": {
        "type": "object",
        "properties": {
          "district_id": {
            "type": "integer",
            "example": 1
          },
          "district_name": {
            "type": "string",
            "example": "Colombo"
          },
          "total_installations": {
            "type": "integer",
            "example": 10
          },
          "current_power_kw": {
            "type": "number",
            "example": 0
          },
          "total_energy_kwh": {
            "type": "number",
            "example": 4034.84
          },
          "peak_power_kw": {
            "type": "number",
            "example": 13.61
          }
        }
      },
      "ReadingsHistoryEnvelope": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "example": 672
          },
          "next": {
            "type": "string",
            "nullable": true,
            "example": "http://localhost:3000/installations/1/readings?page=2&limit=50"
          },
          "previous": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GenerationReading"
            }
          }
        }
      },
      "CreateReadingPayload": {
        "type": "object",
        "required": [
          "timestamp",
          "power_kw",
          "cumulative_energy_kwh",
          "voltage"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-05T02:30:00Z"
          },
          "power_kw": {
            "type": "number",
            "example": 4.5
          },
          "cumulative_energy_kwh": {
            "type": "number",
            "example": 395.2
          },
          "voltage": {
            "type": "number",
            "example": 231.4
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "RESOURCE_NOT_FOUND"
              },
              "message": {
                "type": "string",
                "example": "Province not found"
              }
            }
          }
        }
      },
      "LoginPayload": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "national_admin"
          },
          "password": {
            "type": "string",
            "example": "Admin@123"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Login successful"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "example": 1
              },
              "username": {
                "type": "string",
                "example": "national_admin"
              },
              "name": {
                "type": "string",
                "example": "National Admin"
              },
              "email": {
                "type": "string",
                "example": "admin@slsea.gov.lk"
              },
              "role": {
                "type": "string",
                "example": "national"
              },
              "jurisdiction_id": {
                "type": "integer",
                "nullable": true,
                "example": null
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "User authentication / login",
        "description": "Authenticate user credentials (username & password) and return user profile details including RBAC role and jurisdiction_id",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing username or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Authentication"
        ]
      }
    },
    "/provinces": {
      "get": {
        "summary": "List all provinces",
        "description": "Query all provinces from MongoDB",
        "security": [
          {
            "UserAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Bare array of all provinces",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Province"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Provinces"
        ]
      }
    },
    "/provinces/{id}": {
      "get": {
        "summary": "Get province by ID",
        "description": "Find a province where id matches numeric ID parameter",
        "security": [
          {
            "UserAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Province object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Province"
                }
              }
            }
          },
          "401": {
            "description": "Invalid user identification",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Access denied: resource outside jurisdiction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Province not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Provinces"
        ]
      }
    },
    "/provinces/{id}/districts": {
      "get": {
        "summary": "List districts in province",
        "description": "Query all districts where province_id matches numeric ID",
        "security": [
          {
            "UserAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of scoped districts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/District"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Province not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Provinces"
        ]
      }
    },
    "/districts": {
      "get": {
        "summary": "List all districts",
        "description": "Query all districts from MongoDB",
        "security": [
          {
            "UserAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Bare array of all districts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/District"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Districts"
        ]
      }
    },
